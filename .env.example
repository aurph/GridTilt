# Server
SESSION_SECRET=replace-me-with-a-long-random-string

# Optional: NewsData.io API key for additional news ticker sources.
# Without this, the ticker still works using the 8 built-in RSS feeds.
# Get a free key at https://newsdata.io
NEWSDATA_API_KEY=

# Optional: PostgreSQL connection string. The app falls back to in-memory
# storage when DATABASE_URL is not set, which is fine for local dev.
DATABASE_URL=
