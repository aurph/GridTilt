# Required: HMAC key for signing email unsubscribe tokens.
# Generate with: openssl rand -hex 32
UNSUB_TOKEN_SECRET=replace-me-with-a-long-random-string

# Required to use the admin endpoints (/api/admin/* and /api/newsletter/send).
# Distinct from UNSUB_TOKEN_SECRET so leaking one does not compromise the other.
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=replace-me-with-a-long-random-string

# Optional: Resend API key. Without it, the subscribe endpoint still saves
# emails locally but does not sync to Resend or send newsletters.
RESEND_API_KEY=

# Optional: EIA open-data API key. Free, instant:
# https://www.eia.gov/opendata/register.php
# Enables live US48 hourly electricity demand at /api/physical/load-hourly.
EIA_API_KEY=

# Optional: NewsData.io API key for additional news ticker sources.
# Without this, the ticker still works using the 8 built-in RSS feeds.
# Get a free key at https://newsdata.io
NEWSDATA_API_KEY=

# Optional: X (Twitter) API credentials for the daily auto-poster.
# Generate at developer.x.com → your App → Keys and tokens.
# The App must have "Read and Write" permission BEFORE generating the access token.
# Without all four, /api/admin/cron/daily-tweet runs in dry-run mode and only
# logs the would-be tweet to server/data/social-log.json.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Carto basemap API key for the map tiles. Free tier is 5M tile requests/month:
# https://carto.com/basemaps/apikey
# Without it Carto still serves tiles, but stamps "API KEY REQUIRED" across
# every one of them. Injected into index.html at request time, so rotating the
# key needs a restart, not a rebuild. It is visible to anyone using the site
# (all browser basemaps are) - restrict it by domain in the Carto dashboard.
CARTO_API=

# Privacy-respecting pageview analytics (GoatCounter, https://www.goatcounter.com).
# Your site code, e.g. "gridtilt" for gridtilt.goatcounter.com. Build-time var:
# set it in deployment secrets before the build. Unset = analytics fully off.
VITE_GOATCOUNTER_CODE=
